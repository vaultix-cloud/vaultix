{
  "$description": "Vaultix semantic tokens, dark theme (the default). Components use these and component tokens only, never primitives.",
  "color": {
    "$type": "color",
    "surface": {
      "canvas": {
        "$value": "{color.neutral.950}"
      },
      "base": {
        "$value": "{color.neutral.900}"
      },
      "raised": {
        "$value": "{color.neutral.850}"
      },
      "overlay": {
        "$value": "{color.neutral.800}"
      },
      "sunken": {
        "$value": "{color.neutral.1000}"
      },
      "field": {
        "$value": "{color.neutral.1000}",
        "$description": "Fill behind text the person types: recessed in dark, paper-white in light."
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.50}"
      },
      "secondary": {
        "$value": "{color.neutral.300}"
      },
      "muted": {
        "$value": "{color.neutral.400}"
      },
      "disabled": {
        "$value": "{color.neutral.600}"
      },
      "inverse": {
        "$value": "{color.neutral.950}"
      },
      "on-accent": {
        "$value": "{color.neutral.1000}"
      },
      "link": {
        "$value": "{color.gold.400}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.800}"
      },
      "default": {
        "$value": "{color.neutral.700}"
      },
      "strong": {
        "$value": "{color.neutral.500}"
      },
      "control": {
        "$value": "{color.neutral.500}"
      }
    },
    "accent": {
      "base": {
        "$value": "{color.gold.500}"
      },
      "hover": {
        "$value": "{color.gold.400}"
      },
      "active": {
        "$value": "{color.gold.600}"
      },
      "subtle": {
        "$value": "{color.gold.950}"
      },
      "subtle-text": {
        "$value": "{color.gold.300}"
      },
      "indicator": {
        "$value": "{color.gold.500}"
      },
      "solid": {
        "$value": "{color.gold.500}",
        "$description": "Accent for graphics that carry state (a checked box, an on switch): at least 3:1 against surfaces in both themes."
      },
      "solid-hover": {
        "$value": "{color.gold.400}"
      },
      "solid-fg": {
        "$value": "{color.neutral.1000}",
        "$description": "Marks drawn on accent.solid."
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.gold.400}"
      }
    },
    "interactive": {
      "hover": {
        "$value": "{color.neutral.800}"
      },
      "active": {
        "$value": "{color.neutral.700}"
      },
      "selected": {
        "$value": "{color.gold.950}"
      },
      "selected-text": {
        "$value": "{color.gold.300}"
      },
      "disabled": {
        "$value": "{color.neutral.850}"
      },
      "highlight": {
        "$value": "{color.neutral.700}",
        "$description": "The option under the pointer or keyboard in a floating list (menus, listboxes) on an overlay surface."
      }
    },
    "status": {
      "success": {
        "$value": "{color.green.400}"
      },
      "success-subtle": {
        "$value": "{color.green.950}"
      },
      "warning": {
        "$value": "{color.orange.400}"
      },
      "warning-subtle": {
        "$value": "{color.orange.950}"
      },
      "danger": {
        "$value": "{color.red.400}"
      },
      "danger-strong": {
        "$value": "{color.red.300}",
        "$description": "Danger text on tinted or highlighted backgrounds, where the base danger colour falls short of 4.5:1."
      },
      "danger-subtle": {
        "$value": "{color.red.950}"
      },
      "danger-solid": {
        "$value": "{color.red.600}"
      },
      "danger-solid-hover": {
        "$value": "{color.red.700}"
      },
      "info": {
        "$value": "{color.blue.400}"
      },
      "info-subtle": {
        "$value": "{color.blue.950}"
      }
    },
    "backdrop": {
      "$value": "oklch(0.1 0.02 255 / 0.72)",
      "$description": "Dims the page behind a modal dialog or sheet."
    }
  },
  "elevation": {
    "$type": "shadow",
    "overlay": {
      "$value": "0 24px 64px oklch(0 0 0 / 0.55), 0 2px 8px oklch(0 0 0 / 0.4)",
      "$description": "Dialogs, sheets and menus that float above the page."
    }
  }
}
