{
  "name": "@vaultix/documents",
  "version": "0.5.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Vaultix's versioned documents (AI connections, personas) authored in ArkType, with a version registry and a portable JSON Schema 2020-12 export. No Zod.",
  "scripts": {
    "export": "node scripts/export.mjs",
    "check": "node scripts/export.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "arktype": "2.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
