{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/schemas/vaultix.gate-receipt.v1.schema.json",
  "title": "Vaultix gate receipt",
  "description": "The record of one delivery-gate run on one commit (docs/0142): each check with its result and time in seconds, the tier, and whether the worktree was clean. A merge requires a passing full-tier receipt for the exact commit.",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "maxItems": 200,
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 63
              },
              "reason": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e]+$",
                "minLength": 1,
                "maxLength": 160
              },
              "seconds": {
                "const": 0
              },
              "status": {
                "const": "skipped"
              }
            },
            "required": [
              "id",
              "reason",
              "seconds",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 63
              },
              "seconds": {
                "type": "number",
                "maximum": 86400,
                "minimum": 0
              },
              "status": {
                "const": "fail"
              },
              "exitCode": {
                "type": "integer",
                "maximum": 4294967295,
                "minimum": -2147483648
              }
            },
            "required": [
              "id",
              "seconds",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 63
              },
              "seconds": {
                "type": "number",
                "maximum": 86400,
                "minimum": 0
              },
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "id",
              "seconds",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 63
              },
              "seconds": {
                "type": "number",
                "maximum": 86400,
                "minimum": 0
              },
              "status": {
                "const": "timeout"
              }
            },
            "required": [
              "id",
              "seconds",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "clean": {
      "type": "boolean"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "finishedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$",
      "minLength": 20,
      "maxLength": 24
    },
    "result": {
      "enum": [
        "fail",
        "pass"
      ]
    },
    "schemaVersion": {
      "const": "vaultix.gate-receipt.v1"
    },
    "startedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$",
      "minLength": 20,
      "maxLength": 24
    },
    "tier": {
      "enum": [
        "fast",
        "full"
      ]
    }
  },
  "required": [
    "checks",
    "clean",
    "commit",
    "finishedAt",
    "result",
    "schemaVersion",
    "startedAt",
    "tier"
  ],
  "additionalProperties": false
}
