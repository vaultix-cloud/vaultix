    "/api/vx/v1/secrets/injections/{handle}/redeem": {
      "post": {
        "tags": [
          "secrets"
        ],
        "summary": "Redeem a handle: once, for the identity it was made for. The only operation that returns a value.\nAn unknown, used, expired or wrong-identity handle all answer the same way.",
        "operationId": "redeemInjection",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "description": "The handle from `POST /secrets/injections`; bound to the issuing session",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The values, sent with Cache-Control: no-store",
