    "/api/vx/v1/operate/jobs": {
      "get": {
        "tags": [
          "operate"
        ],
        "summary": "Background jobs, newest first. A failed job stays here, with its reason, until a person retries it.",
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Only jobs in this state.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "succeeded",
                "dead"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many, newest first; 1 to 500, default 100.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
