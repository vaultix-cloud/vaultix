  "components": {
    "schemas": {
      "AuditEvent": {
        "type": "object",
        "required": [
          "chain",
          "seq",
          "at",
          "actor",
          "action",
          "objectRef",
          "outcome",
          "detail",
          "hasValueFingerprint"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "chain": {
            "type": "string"
          },
          "detail": {
            "type": "object"
          },
          "hasValueFingerprint": {
            "type": "boolean",
            "description": "True when the event carries a keyed fingerprint of a value; the fingerprint itself is never shown."
          },
          "objectRef": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AuditEventsResponse": {
        "type": "object",
        "required": [
          "chain",
          "events"
        ],
        "properties": {
          "chain": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          }
        }
      },
      "AuditVerifyResponse": {
        "type": "object",
        "description": "The result of re-computing an audit chain. When it is intact `events` is the number of events;\nwhen it is not, `firstAlteredEvent` is the first sequence number that does not verify.",
        "required": [
          "chain",
          "intact"
